{
  "name": "photobeo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.2.0",
    "@fontsource/nunito": "^5.2.0",
    "@napi-rs/canvas": "^1.1.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  }
}

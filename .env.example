PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
PHOTO_BEO_DATA_DIR=.data
STORAGE_DRIVER=local
# Local private object directory defaults to PHOTO_BEO_DATA_DIR/objects.
# PHOTO_BEO_OBJECT_DIR=.data/objects
# For private S3-compatible storage (server only, never VITE_*):
# STORAGE_DRIVER=s3
# S3_BUCKET=photobeo-private
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Production: NODE_ENV=production, HOST=0.0.0.0, FRONTEND_ORIGIN=https://your-domain
# Use TRUST_PROXY=1 only behind a trusted reverse proxy with direct access restricted.
TRUST_PROXY=0
